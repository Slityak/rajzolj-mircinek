{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deszepmacskavagymirci",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // A Vue build (dist/client) statikus assetként megy ki; minden más kérés az SPA-ra esik vissza,
  // kivéve az /api/* útvonalakat, amiket a Worker kap meg.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Workers AI (Jev). "remote": true → `npm run dev` alatt is a valódi Cloudflare modellt hívja.
  "ai": { "binding": "AI", "remote": true },
  // Every judge call is a paid model call: cap it per client IP.
  "ratelimits": [{ "name": "JUDGE_LIMITER", "namespace_id": "1001", "simple": { "limit": 90, "period": 60 } }],
  "observability": { "enabled": true }
}
